{
  "name": "usb-agent-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch apps/server/index.ts",
    "start": "tsx apps/server/index.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:browser": "playwright test",
    "sandbox:build": "docker build --target ${DEVICEDOCK_VARIANT:-contiki} -t devicedock-sandbox:local -f sandbox/Dockerfile .",
    "sandbox:start": "tsx scripts/sandbox.ts start",
    "sandbox:stop": "tsx scripts/sandbox.ts stop",
    "sandbox:clean": "tsx scripts/sandbox.ts clean",
    "open": "node scripts/open.mjs",
    "login:codex": "tsx scripts/login-relay.ts",
    "device": "tsx packages/device-client/cli.ts",
    "mcp": "tsx packages/mcp-server/index.ts",
    "postinstall": "node scripts/prepare-pty.mjs",
    "prestart": "node scripts/prepare-pty.mjs",
    "predev": "node scripts/prepare-pty.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.1.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@types/w3c-web-serial": "^1.0.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
